# Salin ke .env lalu sesuaikan. File .env tidak di-commit.

# --- Database (container lokal; 5433 karena 5432 sering dipakai Postgres lokal) ---
POSTGRES_USER=bhv
POSTGRES_PASSWORD=bhv
POSTGRES_DB=bhv
DB_PORT=5433

# --- API ---
DATABASE_URL=postgresql+psycopg://bhv:bhv@localhost:5433/bhv
# DB khusus test (dibuat ulang otomatis oleh pytest)
TEST_DATABASE_URL=postgresql+psycopg://bhv:bhv@localhost:5433/bhv_test
APP_ENV=development
# Origin frontend yang diizinkan untuk request mutasi (cek CSRF), pisahkan dengan koma
ALLOWED_ORIGINS=http://localhost:3000
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
COOKIE_SECURE=false

# --- Web ---
API_ORIGIN=http://localhost:8000
